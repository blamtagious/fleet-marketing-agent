{
  "name": "fleet-marketing-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Full-service marketing agent for the Ford of Murfreesboro Fleet Department (Statewide Contract Dept), built on the Claude Agent SDK.",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "agent": "tsx src/cli.ts",
    "chat": "tsx src/cli.ts --chat",
    "check": "tsx scripts/check-draft.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.287",
    "dotenv": "^17.2.3",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
