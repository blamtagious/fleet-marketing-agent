# Anthropic API key. Alternatively run `ant auth login` or `claude` login and leave this unset.
ANTHROPIC_API_KEY=

# Model for the main agent and subagents. Defaults to claude-opus-5-5.
FLEET_AGENT_MODEL=claude-opus-5-5

# Effort level: low | medium | high | xhigh | max. Defaults to high.
FLEET_AGENT_EFFORT=high
